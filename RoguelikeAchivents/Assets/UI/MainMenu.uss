/* =========================
   RAÍZ
   ========================= */
.root {
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    font-family: unity-font-definition;
}

/* =========================
   FONDO INVERNAL (SEGURO)
   ========================= */
.background {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: #0c1e2b;
}

/* =========================
   CONTENEDOR PRINCIPAL
   ========================= */
.menu-container {
    width: 420px;

    padding-left: 32px;
    padding-right: 32px;
    padding-top: 28px;
    padding-bottom: 32px;

    background-color: rgba(220, 240, 255, 0.08);

    border-radius: 16px;
    border-width: 2px;
    border-color: rgba(180, 220, 255, 0.25);

    align-items: center;
}

/* =========================
   TÍTULOS
   ========================= */
.title {
    font-size: 36px;
    unity-font-style: bold;
    letter-spacing: 2px;
    color: #e6f6ff;
    margin-bottom: 6px;
}

.subtitle {
    font-size: 14px;
    color: #b6d9ee;
    margin-bottom: 24px;
}

/* =========================
   CONTENEDOR DE BOTONES
   ========================= */
.menu-buttons {
    width: 100%;
    gap: 12px;
}

/* =========================
   BOTONES
   ========================= */
.menu-button {
    height: 44px;
    font-size: 16px;
    unity-font-style: bold;

    color: #eaf7ff;
    background-color: rgba(120, 180, 220, 0.15);

    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(180, 220, 255, 0.4);
}

.menu-button:hover {
    background-color: rgba(160, 220, 255, 0.35);
}

.menu-button:active {
    background-color: rgba(200, 240, 255, 0.45);
}

/* =========================
   BOTÓN SALIR
   ========================= */
.menu-button.exit {
    margin-top: 16px;
    background-color: rgba(200, 80, 80, 0.15);
    border-color: rgba(255, 140, 140, 0.4);
}

.menu-button.exit:hover {
    background-color: rgba(255, 120, 120, 0.35);
}
