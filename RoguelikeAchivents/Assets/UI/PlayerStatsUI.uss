/* ===== ROOT ===== */
.root {
    flex-grow: 1;
    padding: 4%;
    background-color: #0c1e2b;
}

/* ===== TÍTULO ===== */
.title {
    font-size: 28px;
    unity-font-style: bold;
    text-align: center;
    margin-bottom: 14px;
    color: #e6f6ff;
}

/* ===== COLUMNAS ===== */
.columns {
    flex-direction: row;
    gap: 16px;
}

.column {
    flex-grow: 1;
}

/* ===== SECCIONES ===== */
.section {
    padding: 12px;
    background-color: rgba(220, 240, 255, 0.08);
    border-radius: 14px;
    border-width: 1px;
    border-color: rgba(180, 220, 255, 0.25);
    box-shadow: 0 6px 14px rgba(0, 20, 40, 0.6);
}

.section-title {
    font-size: 18px;
    unity-font-style: bold;
    margin-bottom: 10px;
    color: #d9effa;
}

/* ===== FILAS ===== */
.row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

/* ===== TEXTO ===== */
Label {
    color: #b6d9ee;
    font-size: 14px;
}

/* ===== NOMBRE ===== */
.name-container {
    margin-bottom: 12px;
}

.name-label {
    margin-bottom: 4px;
    color: #d9effa;
}

/* ===== PUNTOS ===== */
.points-container {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 12px;
}

.points-value {
    unity-font-style: bold;
    margin-left: 6px;
    font-size: 16px;
    color: #8fd3ff;
}

/* ===== ATRIBUTOS ===== */
.attr-name {
    flex-grow: 2;
}

.attribute-value {
    min-width: 40px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    unity-font-style: bold;
    font-size: 16px;
    color: #a8dcff;
    -unity-text-align: upper-center;
}

/* ===== ESTADÍSTICAS ===== */
.stat-name {
    flex-grow: 2;
    color: #cce9f7;
}

.stat-value {
    min-width: 40px;
    text-align: center;
    unity-font-style: bold;
    color: #e6f6ff;
    -unity-text-align: upper-center;
}

/* ===== ENTRY BOX ===== */
.entry-box {
    margin-bottom: 6px;
    padding: 8px 10px;
    background-color: rgba(240, 250, 255, 0.08);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(180, 220, 255, 0.2);
    box-shadow: 0 2px 6px rgba(0, 30, 60, 0.5);
}

.stat-box {
    background-color: rgba(240, 250, 255, 0.05);
}

/* ===== BOTONES ===== */
Button {
    min-width: 32px;
    height: 28px;
    border-radius: 8px;
    unity-font-style: bold;
    color: #eaf7ff;
}

/* + */
.btn-plus {
    background-color: rgba(120, 180, 220, 0.2);
}

.btn-plus:hover {
    background-color: rgba(160, 220, 255, 0.35);
}

.btn-plus:active {
    background-color: rgba(200, 240, 255, 0.45);
}

/* - */
.btn-minus {
    background-color: rgba(120, 140, 160, 0.2);
}

.btn-minus:hover {
    background-color: rgba(160, 180, 200, 0.35);
}

.btn-minus:active {
    background-color: rgba(200, 220, 240, 0.45);
}

/* ===== BOTÓN FINAL ===== */
.create-container {
    margin-top: 16px;
    align-items: center;
}

.btn-create {
    min-width: 240px;
    height: 44px;
    font-size: 18px;
    unity-font-style: bold;

    background-color: rgba(120, 180, 220, 0.25);
    color: #eaf7ff;

    border-radius: 16px;
    border-width: 1px;
    border-color: rgba(180, 220, 255, 0.4);
}

.btn-create:hover {
    background-color: rgba(160, 220, 255, 0.4);
}

.btn-create:active {
    background-color: rgba(200, 240, 255, 0.5);
}
