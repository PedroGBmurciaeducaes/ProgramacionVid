<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Label text="Label" name="FoodLabel" style="color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/Roguelike2D/TutorialAssets/Fonts/PressStart2P-Regular.ttf?fileID=12800000&amp;guid=b284a6525342f44599e9ce79e37c2d61&amp;type=3#PressStart2P-Regular&quot;); font-size: 30px; -unity-text-align: lower-center; position: absolute; top: 0; left: 0; bottom: 0; right: 0;" />
    <ui:Label text="Nombre" name="PlayerNameLabel" style="color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/Roguelike2D/TutorialAssets/Fonts/PressStart2P-Regular.ttf?fileID=12800000&amp;guid=b284a6525342f44599e9ce79e37c2d61&amp;type=3#PressStart2P-Regular&quot;); font-size: 24px; -unity-text-align: middle-center; position: absolute; top: 30px; left: 0; right: 0;" />
    <ui:VisualElement name="GameOverPanel" style="flex-grow: 1; position: absolute; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.78);">
        <ui:Label text="GAME OVER" name="GameOverMessage" style="background-color: rgb(0, 0, 0); color: rgb(255, 0, 18); justify-content: space-around; align-items: center; align-self: auto; align-content: flex-start; font-size: 49px; -unity-text-outline-color: rgba(0, 0, 0, 0);" />
    </ui:VisualElement>
    <ui:Label name="CombatMessage" style="color: rgb(255, 255, 0); -unity-font-definition: url(&quot;project://database/Assets/Roguelike2D/TutorialAssets/Fonts/PressStart2P-Regular.ttf?fileID=12800000&amp;guid=b284a6525342f44599e9ce79e37c2d61&amp;type=3#PressStart2P-Regular&quot;); font-size: 20px; -unity-text-align: middle-center; position: absolute; bottom: 40px; left: 0; right: 0; opacity: 0;" />
    <ui:VisualElement name="KeyContainer" style="flex-direction: row; align-items: center; position: absolute; top: 70px; right: 20px; background-color: rgba(0, 0, 0, 0.6); padding-left: 8px; padding-right: 8px; padding-top: 4px; padding-bottom: 4px; border-radius: 6px;">
        <ui:Image name="KeyIcon" style="width: 32px; height: 32px; margin-right: 6px; background-image: url(&quot;project://database/Assets/Tiles/CofreYExp/llave.png?fileID=2800000&amp;guid=5019f5e5cf683bb4fbd857dbdce21fd2&amp;type=3#llave&quot;);" />
        <ui:Label name="KeyLabel" text="x0" style="color: white; font-size: 20px; -unity-font-definition: url(&quot;project://database/Assets/Roguelike2D/TutorialAssets/Fonts/PressStart2P-Regular.ttf?fileID=12800000&amp;guid=b284a6525342f44599e9ce79e37c2d61&amp;type=3#PressStart2P-Regular&quot;);" />
    </ui:VisualElement>
    <ui:VisualElement name="ExpContainer" style="flex-direction: row; align-items: center; position: absolute; top: 30px; right: 20px; background-color: rgba(0, 0, 0, 0.6); padding-left: 8px; padding-right: 8px; padding-top: 4px; padding-bottom: 4px; border-radius: 6px;">
        <ui:Image name="ExpIcon" style="width: 32px; height: 32px; margin-right: 6px; background-image: url(&quot;project://database/Assets/Tiles/CofreYExp/sprite_variant_2.png?fileID=2800000&amp;guid=9e1d5b7b48dc1f045b07a899385b3a3a&amp;type=3#sprite_variant_2&quot;);" />
        <ui:Label name="ExpLabel" text="x0" style="color: white; font-size: 20px; -unity-font-definition: url(&quot;project://database/Assets/Roguelike2D/TutorialAssets/Fonts/PressStart2P-Regular.ttf?fileID=12800000&amp;guid=b284a6525342f44599e9ce79e37c2d61&amp;type=3#PressStart2P-Regular&quot;);" />
    </ui:VisualElement>
</ui:UXML>
